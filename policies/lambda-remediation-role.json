{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowDescribeSecurityGroups",
      "Effect": "Allow",
      "Action": "ec2:DescribeSecurityGroups",
      "Resource": "*"
    },
    {
      "Sid": "AllowRevokeIngressOnSecurityGroupsInThisAccount",
      "Effect": "Allow",
      "Action": "ec2:RevokeSecurityGroupIngress",
      "Resource": "arn:aws:ec2:us-east-1:<ACCOUNT_ID>:security-group/*"
    },
    {
      "Sid": "AllowCreateLogGroup",
      "Effect": "Allow",
      "Action": "logs:CreateLogGroup",
      "Resource": "arn:aws:logs:us-east-1:<ACCOUNT_ID>:*"
    },
    {
      "Sid": "AllowWriteOwnLogStreams",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "arn:aws:logs:us-east-1:<ACCOUNT_ID>:log-group:/aws/lambda/<FUNCTION_NAME>:*"
    }
  ]
}
